// Array .splice_arr(start, deleteCount, insertArray)
// Same as .splice() but inserts come from an array instead of varargs.
var h = require("tests/test_helpers.ci")
h()

// === insert array in middle ===
print("running sarr_insert_mid")
var a = [1, 2, 5]
a.splice_arr(2, 0, [3, 4])
test.equal(a.len(), 5, "sarr_insert_mid")
test.equal(a[2], 3, "sarr_insert_mid")
test.equal(a[3], 4, "sarr_insert_mid")
test.equal(a[4], 5, "sarr_insert_mid")

// === replace with array ===
print("running sarr_replace")
var b = [1, 2, 3, 4, 5]
b.splice_arr(1, 3, [20, 30])
// [1, 20, 30, 5]
test.equal(b.len(), 4, "sarr_replace")
test.equal(b[0], 1, "sarr_replace")
test.equal(b[1], 20, "sarr_replace")
test.equal(b[2], 30, "sarr_replace")
test.equal(b[3], 5, "sarr_replace")

// === delete only, no insert array ===
print("running sarr_del_only")
var c = [1, 2, 3, 4]
c.splice_arr(1, 2)
test.equal(c.len(), 2, "sarr_del_only")
test.equal(c[0], 1, "sarr_del_only")
test.equal(c[1], 4, "sarr_del_only")

// === empty insert array = just delete ===
print("running sarr_empty_ins")
var d = [1, 2, 3, 4, 5]
d.splice_arr(1, 2, [])
test.equal(d.len(), 3, "sarr_empty_ins")
test.equal(d[0], 1, "sarr_empty_ins")
test.equal(d[1], 4, "sarr_empty_ins")

// === insert at start ===
print("running sarr_prepend")
var e = [3, 4]
e.splice_arr(0, 0, [1, 2])
test.equal(e.len(), 4, "sarr_prepend")
test.equal(e[0], 1, "sarr_prepend")
test.equal(e[3], 4, "sarr_prepend")

// === insert at end ===
print("running sarr_append")
var f = [1, 2]
f.splice_arr(2, 0, [3, 4])
test.equal(f.len(), 4, "sarr_append")
test.equal(f[2], 3, "sarr_append")
test.equal(f[3], 4, "sarr_append")

// === insert array with offset (circular src) ===
print("running sarr_circular_src")
var src = []
var i = 0
while i < 8 {
	src.push(i)
	i = i + 1
}
i = 0
while i < 5 {
	src.shift()
	i = i + 1
}
// src = [5, 6, 7], offset nonzero
var g = [1, 2, 10]
g.splice_arr(2, 0, src)
// [1, 2, 5, 6, 7, 10]
test.equal(g.len(), 6, "sarr_circular_src")
test.equal(g[2], 5, "sarr_circular_src")
test.equal(g[4], 7, "sarr_circular_src")
test.equal(g[5], 10, "sarr_circular_src")

// === splice_arr matches splice for same data ===
print("running sarr_matches_splice")
var x = [1, 2, 3, 4, 5]
var y = [1, 2, 3, 4, 5]
x.splice(1, 2, 10, 20, 30)
y.splice_arr(1, 2, [10, 20, 30])
test.equal(x.len(), y.len(), "sarr_matches_splice")
i = 0
while i < x.len() {
	test.equal(x[i], y[i], "sarr_matches_splice")
	i = i + 1
}

// === returns self ===
print("running sarr_returns_self")
var r = [1, 2, 3]
var ret = r.splice_arr(1, 1, [99])
test.equal(ret[1], 99, "sarr_returns_self")

test.done()
