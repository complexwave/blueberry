// Array tests: .get() and .set() methods
var h = require("tests/test_helpers.ci")
h()

// === get basic ===
print("running arr_get_basic")
var a = [10, 20, 30]
test.equal(a.get(0), 10, "arr_get_basic")
test.equal(a.get(1), 20, "arr_get_basic")
test.equal(a.get(2), 30, "arr_get_basic")

// === get out of bounds returns null ===
print("running arr_get_oob")
test.equal(a.get(3), null, "arr_get_oob")
test.equal(a.get(99), null, "arr_get_oob")

// === get negative wraps ===
print("running arr_get_neg_last")
test.equal(a.get(-1), 30, "arr_get_neg_last")

print("running arr_get_neg_first")
test.equal(a.get(-3), 10, "arr_get_neg_first")

print("running arr_get_neg_mid")
test.equal(a.get(-2), 20, "arr_get_neg_mid")

// === get negative out of bounds returns null ===
print("running arr_get_neg_oob")
test.equal(a.get(-4), null, "arr_get_neg_oob")
test.equal(a.get(-999), null, "arr_get_neg_oob")

// === set basic ===
print("running arr_set_basic")
var b = [1, 2, 3]
b.set(1, 99)
test.equal(b[1], 99, "arr_set_basic")
test.equal(b.get(1), 99, "arr_set_basic")

// === set extends array ===
print("running arr_set_extend")
var c = [1, 2]
c.set(5, 42)
test.equal(c.len(), 6, "arr_set_extend")
test.equal(c.get(5), 42, "arr_set_extend")
test.equal(c.get(2), null, "arr_set_extend")
test.equal(c.get(3), null, "arr_set_extend")
test.equal(c.get(4), null, "arr_set_extend")

// === get and set match regular indexing ===
print("running arr_get_set_matches_index")
var d = [10, 20, 30, 40, 50]
var i = 0
while i < d.len() {
	test.equal(d.get(i), d[i], "arr_get_set_matches_index")
	i = i + 1
}

print("running arr_set_matches_index_store")
d.set(2, 999)
test.equal(d[2], 999, "arr_set_matches_index_store")
d[2] = 30
test.equal(d.get(2), 30, "arr_set_matches_index_store")

// === get/set after queue ops (circular buffer) ===
print("running arr_get_set_circular")
var q = []
i = 0
while i < 20 {
	q.push(i)
	i = i + 1
}
i = 0
while i < 15 {
	q.shift()
	i = i + 1
}
// q = [15, 16, 17, 18, 19], offset nonzero
test.equal(q.get(0), 15, "arr_get_set_circular")
test.equal(q.get(4), 19, "arr_get_set_circular")
q.set(2, 777)
test.equal(q.get(2), 777, "arr_get_set_circular")
test.equal(q[2], 777, "arr_get_set_circular")

// === set with negative index ===
print("running arr_set_neg")
var sn = [10, 20, 30, 40]
sn.set(-1, 99)
test.equal(sn.get(-1), 99, "arr_set_neg")
test.equal(sn[3], 99, "arr_set_neg")

print("running arr_set_neg_first")
sn.set(-4, 77)
test.equal(sn[0], 77, "arr_set_neg_first")

// === set on empty via extend ===
print("running arr_set_empty_extend")
var e = []
e.set(0, 42)
test.equal(e.len(), 1, "arr_set_empty_extend")
test.equal(e.get(0), 42, "arr_set_empty_extend")

// === get on empty ===
print("running arr_get_empty")
var f = []
test.equal(f.get(0), null, "arr_get_empty")

test.done()
