print("DRAFT: subscript_access")
var config = {}
config["name"] = "test"

config["debug"] = fn() {
	print("method: ", self)
}

var a = config["debug"]

print(1, a)
var m4;

config.debug()

config.("debug") ()

// rawget style map thingy

var dbg = "debug"

print(2)
config->debug()

print(3)
config->("debug") ()


print(4)
// bind
var bound = config<-debug
bound()


print(5)
bound = config<-(dbg)
bound()





