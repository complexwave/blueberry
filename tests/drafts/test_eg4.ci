var h = require("tests/test_helpers.ci")
h()

// %g with number()
print(string.format("[%g]", number("1.5e10")))
print(string.format("[%g]", number("1.5e-10")))
print(string.format("[%g]", number("1e100")))
print(string.format("[%g]", number("9.99e5")))
print(string.format("[%g]", number("6.022e23")))
print(string.format("[%g]", number("-6.022e23")))
print(string.format("[%g]", number("1e0")))
print(string.format("[%g]", number("1e1")))
print(string.format("[%g]", number("5e2")))

// %g with width
print(string.format("[%20g]", 3.14))
print(string.format("[%-20g]", 3.14))
print(string.format("[%020g]", 3.14))
print(string.format("[%20g]", 42))
print(string.format("[%-20g]", 42))

// mixed e and g
print(string.format("e=%e g=%g", 3.14, 3.14))
print(string.format("e=%e g=%g", 0.001, 0.001))
print(string.format("e=%e g=%g", 100, 100))

test.done()
