// Tree through map.* namespace functions
var h = require("tests/test_helpers.ci")
h()

// === map.len on tree ===
print("running tree_map_len_empty")
var t = tree.new()
test.equal(map.len(t), 0, "tree_map_len_empty")

print("running tree_map_len")
t["a"] = 1
t["b"] = 2
t["c"] = 3
test.equal(map.len(t), 3, "tree_map_len")

// === map.keys on tree (sorted) ===
print("running tree_map_keys")
var k = map.keys(t)
test.equal(k.len(), 3, "tree_map_keys")
test.equal(k[0], "a", "tree_map_keys")
test.equal(k[1], "b", "tree_map_keys")
test.equal(k[2], "c", "tree_map_keys")

// === map.values on tree (sorted by key) ===
print("running tree_map_values")
var v = map.values(t)
test.equal(v.len(), 3, "tree_map_values")
test.equal(v[0], 1, "tree_map_values")
test.equal(v[1], 2, "tree_map_values")
test.equal(v[2], 3, "tree_map_values")

// === map.delete on tree ===
print("running tree_map_delete")
var r = map.delete(t, "b")
test.equal(r, true, "tree_map_delete")
test.equal(map.len(t), 2, "tree_map_delete")

// verify by iterating
var found_b = false
for key, val in t {
	if key == "b" { found_b = true }
}
test.assert(!found_b, "tree_map_delete")

// === map.delete missing key ===
print("running tree_map_delete_missing")
var r2 = map.delete(t, "zzz")
test.equal(r2, false, "tree_map_delete_missing")

// === map.keys/values after delete ===
print("running tree_map_keys_after_delete")
var k2 = map.keys(t)
test.equal(k2.len(), 2, "tree_map_keys_after_delete")
test.equal(k2[0], "a", "tree_map_keys_after_delete")
test.equal(k2[1], "c", "tree_map_keys_after_delete")

print("running tree_map_values_after_delete")
var v2 = map.values(t)
test.equal(v2[0], 1, "tree_map_values_after_delete")
test.equal(v2[1], 3, "tree_map_values_after_delete")

// === map.len on empty tree ===
print("running tree_map_empty_keys_values")
var t2 = tree.new()
test.equal(map.keys(t2).len(), 0, "tree_map_empty_keys_values")
test.equal(map.values(t2).len(), 0, "tree_map_empty_keys_values")

// === int keys through map.* ===
print("running tree_map_int_keys")
var t3 = tree.new()
t3[30] = "c"
t3[10] = "a"
t3[20] = "b"

var ik = map.keys(t3)
test.equal(ik[0], 10, "tree_map_int_keys")
test.equal(ik[1], 20, "tree_map_int_keys")
test.equal(ik[2], 30, "tree_map_int_keys")

var iv = map.values(t3)
test.equal(iv[0], "a", "tree_map_int_keys")
test.equal(iv[1], "b", "tree_map_int_keys")
test.equal(iv[2], "c", "tree_map_int_keys")

// === delete all via map.delete, verify len ===
print("running tree_map_delete_all")
map.delete(t3, 10)
map.delete(t3, 20)
map.delete(t3, 30)
test.equal(map.len(t3), 0, "tree_map_delete_all")

var count = 0
for k, v in t3 {
	count = count + 1
}
test.equal(count, 0, "tree_map_delete_all")

test.done()
