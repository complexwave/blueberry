var h = require("tests/test_helpers.ci")
h()

print("running simple_method_call")
var obj = {}
obj.method = fn() {
	return 42
}
var m1 = obj.method()
test.equal(m1, 42, "simple_method_call")

print("running method_with_self")
var shape = {}
shape.width = 10
shape.height = 5
shape.area = fn() {
	return self.width * self.height
}
var m2 = shape.area()
test.equal(m2, 50, "method_with_self")

print("running distance_with_self")
var point = {}
point.x = 3
point.y = 4
point.distance = fn() {
	return self.x * self.x + self.y * self.y
}
var m3 = point.distance()
test.equal(m3, 25, "distance_with_self")



print("running subscript_access")

var config = {}
config["name"] = "test"

config["debug"] = fn(config) {
	return config["name"]
}

var m4 = config["debug"](config)

test.equal(m4, "test", "subscript_access")


print("running nested_property_access")

var outer = {}
outer.inner = {}
outer.inner.value = 42
var m10 = outer.inner.value
test.equal(m10, 42, "nested_property_access")


print("prototype_chain")
var proto_base = {}
proto_base.value = 100
var proto_child = {}
proto.set(proto_child, proto_base)
var m7 = proto_child.value

test.equal(m7, 100, "prototype_chain: inherit property")

print("running prototype_inheritance")
var animal = {}
animal.name = "creature"
animal.speak = fn() {
	return self.name
}
var dog = {}
dog.name = "dog"
proto.set(dog, animal)
var m6 = dog.speak()
test.equal(m6, "dog", "prototype_inheritance: method with override")

print("running method_chaining_simple")
var rect = {}
rect.w = 10
rect.h = 5
rect.scale = fn(factor) {
	self.w = self.w * factor
	self.h = self.h * factor
	return self
}
var m5 = rect.scale(2)
var m5w = m5.w
var m5h = m5.h
test.equal(m5w, 20, "method_chaining_simple: width")
test.equal(m5h, 10, "method_chaining_simple: height")

print("running self_receiver")
var receiver_test = {}
receiver_test.id = 1
var proto_obj = {}
proto_obj.get_id = fn() {
	return self.id
}
proto.set(receiver_test, proto_obj)
var m8 = receiver_test.get_id()
test.equal(m8, 1, "self_receiver: self is receiver not proto")

print("running setprototype_returns_obj")
var base = {}
base.msg = "hello"
var m9 = proto.set({}, base)
var m9msg = m9.msg
test.equal(m9msg, "hello", "setprototype_returns_obj")

print("running method_shadow_override")
var parent = {}
parent.compute = fn() {
	return 1
}
var child = {}
child.compute = fn() {
	return 2
}
proto.set(child, parent)
var m11p = parent.compute()
var m11c = child.compute()
test.equal(m11p, 1, "method_shadow_override: parent")
test.equal(m11c, 2, "method_shadow_override: child shadow")

print("running three_level_chain")
var level1 = {}
level1.a = 10
var level2 = {}
level2.b = 20
proto.set(level2, level1)
var level3 = {}
level3.c = 30
proto.set(level3, level2)
var m12a = level3.a
var m12b = level3.b
var m12c = level3.c
test.equal(m12a, 10, "three_level_chain: level1 property")
test.equal(m12b, 20, "three_level_chain: level2 property")
test.equal(m12c, 30, "three_level_chain: level3 property")

test.done()
