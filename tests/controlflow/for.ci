// Control flow: for-in loop tests
var h = require("tests/test_helpers.ci")
h()

// --- for-in over array: values and indices ---
print("running for_array tests")
var arr = [10, 20, 30, 40, 50]
var sum = 0
var idx_sum = 0
for i, v in arr {
	sum = sum + v
	idx_sum = idx_sum + i
}
test.equal(sum, 150, "for_array_sum")
test.equal(idx_sum, 10, "for_array_index_sum")  // 0+1+2+3+4=10

// --- for-in over empty array ---
print("running for_empty_array tests")
var count = 0
for i, v in [] {
	count = count + 1
}
test.equal(count, 0, "for_empty_array_no_iters")

// --- for-in over single element ---
print("running for_single tests")
var got = null
for i, v in [42] {
	got = v
	count = i
}
test.equal(got, 42, "for_single_value")
test.equal(count, 0, "for_single_index")

// --- for-in order ---
print("running for_order tests")
var out = []
for i, v in [3, 1, 4, 1, 5] {
	out.push(v)
}
test.equal(out[0], 3, "for_order_0")
test.equal(out[1], 1, "for_order_1")
test.equal(out[4], 5, "for_order_4")

// --- for-in with break ---
print("running for_break tests")
sum = 0
for i, v in [1, 2, 3, 4, 5] {
	if v == 3 {
		break
	}
	sum = sum + v
}
test.equal(sum, 3, "for_break_stops")  // 1+2=3

// --- for-in with next (continue) ---
print("running for_next tests")
sum = 0
for i, v in [1, 2, 3, 4, 5] {
	if v % 2 == 0 {
		next
	}
	sum = sum + v
}
test.equal(sum, 9, "for_next_skips_even")  // 1+3+5=9

// --- for-in over map ---
print("running for_map tests")
var m = { a: 1, b: 2, c: 3 }
var key_count = 0
var val_sum = 0
for k, v in m {
	key_count = key_count + 1
	val_sum = val_sum + v
}
test.equal(key_count, 3, "for_map_key_count")
test.equal(val_sum, 6, "for_map_val_sum")

// --- for-in over empty map ---
print("running for_empty_map tests")
count = 0
for k, v in {} {
	count = count + 1
}
test.equal(count, 0, "for_empty_map_no_iters")

// --- for-in over tree (sorted order) ---
print("running for_tree tests")
var t = tree.new()
t["b"] = 2
t["a"] = 1
t["c"] = 3
var keys = []
var vals = []
for k, v in t {
	keys.push(k)
	vals.push(v)
}
test.equal(keys.len(), 3, "for_tree_count")
test.equal(keys[0], "a", "for_tree_sorted_0")
test.equal(keys[1], "b", "for_tree_sorted_1")
test.equal(keys[2], "c", "for_tree_sorted_2")
test.equal(vals[0], 1, "for_tree_val_0")

// --- nested for-in ---
print("running for_nested tests")
var outer = [[1, 2], [3, 4], [5, 6]]
sum = 0
for i, row in outer {
	for j, v in row {
		sum = sum + v
	}
}
test.equal(sum, 21, "for_nested_sum")  // 1+2+3+4+5+6=21

// --- for-in with index used ---
print("running for_index tests")
var a = [10, 20, 30]
var reconstructed = []
for i, v in a {
	reconstructed.push(i * 10 + v)
}
test.equal(reconstructed[0], 10,  "for_index_0")  // 0*10+10=10
test.equal(reconstructed[1], 30,  "for_index_1")  // 1*10+20=30
test.equal(reconstructed[2], 50,  "for_index_2")  // 2*10+30=50

// --- for-in modifying external var ---
print("running for_mutate tests")
var product = 1
for i, v in [2, 3, 4] {
	product = product * v
}
test.equal(product, 24, "for_mutate_product")

// --- for-in break in nested if ---
print("running for_break_nested tests")
var found = null
for i, v in [5, 10, 15, 20, 25] {
	if v > 12 {
		found = v
		break
	}
}
test.equal(found, 15, "for_break_nested_found")

test.done()
