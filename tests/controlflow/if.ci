// Control flow: if/else/else-if tests
var h = require("tests/test_helpers.ci")
h()

print("running if_basic tests")

// --- basic if true/false ---
var x = 0
if true {
	x = 1
}
test.equal(x, 1, "if_true_executes")

x = 0
if false {
	x = 1
}
test.equal(x, 0, "if_false_skips")

// --- if-else ---
print("running if_else tests")
x = 0
if true {
	x = 1
} else {
	x = 2
}
test.equal(x, 1, "if_else_true_takes_if")

x = 0
if false {
	x = 1
} else {
	x = 2
}
test.equal(x, 2, "if_else_false_takes_else")

// --- if-else if-else ---
print("running if_else_if tests")
x = 0
if false {
	x = 1
} else if true {
	x = 2
} else {
	x = 3
}
test.equal(x, 2, "if_else_if_true")

x = 0
if false {
	x = 1
} else if false {
	x = 2
} else {
	x = 3
}
test.equal(x, 3, "if_else_if_else")

x = 0
if false {
	x = 1
} else if false {
	x = 2
} else if true {
	x = 3
} else {
	x = 4
}
test.equal(x, 3, "if_else_if_else_if_true")

// --- nested if ---
print("running nested_if tests")
x = 0
if true {
	if true {
		x = 1
	}
}
test.equal(x, 1, "nested_if_true_true")

x = 0
if true {
	if false {
		x = 1
	} else {
		x = 2
	}
}
test.equal(x, 2, "nested_if_with_else")

x = 0
if true {
	if true {
		if true {
			x = 1
		}
	}
}
test.equal(x, 1, "triple_nested_if")

// --- falsy values ---
print("running falsy_values tests")
x = 0
if 0 {
	x = 1
}
test.equal(x, 0, "zero_is_falsy")

x = 0
if false {
	x = 1
}
test.equal(x, 0, "false_is_falsy")

x = 0
if null {
	x = 1
}
test.equal(x, 0, "null_is_falsy")

// --- truthy values ---
print("running truthy_values tests")
x = 0
if 1 {
	x = 1
}
test.equal(x, 1, "one_is_truthy")

x = 0
if -1 {
	x = 1
}
test.equal(x, 1, "negative_one_is_truthy")

x = 0
if "" {
	x = 1
}
test.equal(x, 1, "empty_string_is_truthy")

x = 0
if [] {
	x = 1
}
test.equal(x, 1, "empty_array_is_truthy")

x = 0
if {} {
	x = 1
}
test.equal(x, 1, "empty_map_is_truthy")

// --- logical operators ---
print("running logical_operators tests")
x = 0
if true && true {
	x = 1
}
test.equal(x, 1, "and_true_true")

x = 0
if true && false {
	x = 1
}
test.equal(x, 0, "and_true_false")

x = 0
if false && true {
	x = 1
}
test.equal(x, 0, "and_false_true")

x = 0
if true || false {
	x = 1
}
test.equal(x, 1, "or_true_false")

x = 0
if false || false {
	x = 1
}
test.equal(x, 0, "or_false_false")

x = 0
if false || true {
	x = 1
}
test.equal(x, 1, "or_false_true")

// --- comparisons ---
print("running comparison_operators tests")
x = 0
if 1 < 2 {
	x = 1
}
test.equal(x, 1, "comparison_less_than_true")

x = 0
if 2 < 1 {
	x = 1
}
test.equal(x, 0, "comparison_less_than_false")

x = 0
if 1 == 1 {
	x = 1
}
test.equal(x, 1, "comparison_equal_true")

x = 0
if 1 != 2 {
	x = 1
}
test.equal(x, 1, "comparison_not_equal_true")

// --- negation ---
print("running negation tests")
x = 0
if !false {
	x = 1
}
test.equal(x, 1, "not_false")

x = 0
if !true {
	x = 1
}
test.equal(x, 0, "not_true")

x = 0
if !0 {
	x = 1
}
test.equal(x, 1, "not_zero")

x = 0
if !1 {
	x = 1
}
test.equal(x, 0, "not_one")

// --- assignment in condition (if supported) ---
print("running complex_conditions tests")
x = 0
var y = 5
if y > 3 {
	x = 1
}
test.equal(x, 1, "condition_with_variable")

x = 0
if (1 + 1) == 2 {
	x = 1
}
test.equal(x, 1, "condition_with_arithmetic")

x = 0
var a = 10
var b = 20
if a < b && b > 5 {
	x = 1
}
test.equal(x, 1, "complex_condition_and")

x = 0
if a > b || a == 10 {
	x = 1
}
test.equal(x, 1, "complex_condition_or")

test.done()
