// boxing/unboxing tests — verify that arithmetic results stay tagged
// when they fit, and box when they don't, using math.boxed()

var h = require("tests/test_helpers.ci")
h()

// === tagged ints stay tagged after ops ===

print("running tagged_add_stays_tagged")
var r = number(10) + number(20)
test.equal(math.boxed(r), false, "tagged_add_stays_tagged")
test.equal(r, 30, "tagged_add_stays_tagged_value")

print("running tagged_sub_stays_tagged")
r = number(50) - number(30)
test.equal(math.boxed(r), false, "tagged_sub_stays_tagged")
test.equal(r, 20, "tagged_sub_stays_tagged_value")

print("running tagged_mul_stays_tagged")
r = number(6) * number(7)
test.equal(math.boxed(r), false, "tagged_mul_stays_tagged")
test.equal(r, 42, "tagged_mul_stays_tagged_value")

print("running tagged_div_stays_tagged")
r = number(100) / number(10)
test.equal(math.boxed(r), false, "tagged_div_stays_tagged")
test.equal(r, 10, "tagged_div_stays_tagged_value")

print("running tagged_mod_stays_tagged")
r = number(17) % number(5)
test.equal(math.boxed(r), false, "tagged_mod_stays_tagged")
test.equal(r, 2, "tagged_mod_stays_tagged_value")

print("running tagged_neg_stays_tagged")
r = -number(42)
test.equal(math.boxed(r), false, "tagged_neg_stays_tagged")
test.equal(r, -42, "tagged_neg_stays_tagged_value")

// === small int literals are never boxed ===

print("running literal_not_boxed")
test.equal(math.boxed(42), false, "literal_not_boxed")
test.equal(math.boxed(-1), false, "literal_neg_not_boxed")
test.equal(math.boxed(0), false, "literal_zero_not_boxed")

// === int arithmetic stays tagged ===

print("running int_add_not_boxed")
r = 100 + 200
test.equal(math.boxed(r), false, "int_add_not_boxed")

print("running int_mul_not_boxed")
r = 100 * 100
test.equal(math.boxed(r), false, "int_mul_not_boxed")

// === overflow forces boxing ===

print("running overflow_mul_boxes")
var big = 1000000000000000
r = big * big
test.equal(math.boxed(r), true, "overflow_mul_boxes")
test.equal(math.type(r), "int", "overflow_mul_type_int")

// === float ops always boxed ===

print("running float_literal_boxed")
test.equal(math.boxed(3.14), true, "float_literal_boxed")
test.equal(math.type(3.14), "float", "float_literal_type")

print("running float_add_boxed")
r = 1.5 + 2.5
test.equal(math.boxed(r), true, "float_add_boxed")
test.equal(math.type(r), "float", "float_add_type")

// === int + float promotes to float (boxed) ===

print("running int_float_promo_boxed")
r = 10 + 1.5
test.equal(math.boxed(r), true, "int_float_promo_boxed")
test.equal(math.type(r), "float", "int_float_promo_type")

print("running float_int_promo_boxed")
r = 1.5 + 10
test.equal(math.boxed(r), true, "float_int_promo_boxed")
test.equal(math.type(r), "float", "float_int_promo_type")

// === bitwise coercion: float | 0 → int ===

print("running float_bitor_zero_unboxes")
r = 3.14 | 0
test.equal(math.type(r), "int", "float_bitor_zero_type")

print("running float_bitand_unboxes")
r = 7.9 & 0xFF
test.equal(math.type(r), "int", "float_bitand_type")

// === pow: small result stays tagged ===

// pow inside print/call parens is a codegen bug — skip for now
// print("running pow_small_tagged")
// r = 2 ** 10
// test.equal(r, 1024, "pow_small_tagged_value")
// test.equal(math.boxed(r), false, "pow_small_tagged")
test.skip("pow_small_tagged")

// print("running pow_large_boxes")
// r = 2 ** 63
// test.equal(math.boxed(r), true, "pow_large_boxes")
// test.equal(math.type(r), "int", "pow_large_type")
test.skip("pow_large_boxes")

// === neg of float stays float ===

print("running neg_float_stays_float")
r = -3.14
test.equal(math.type(r), "float", "neg_float_stays_float")
test.equal(math.boxed(r), true, "neg_float_boxed")

// === chain: box → operate → unbox ===

print("running chain_box_unbox")
var boxed = number(1000)
r = boxed + number(1)
test.equal(r, 1001, "chain_box_unbox_value")
test.equal(math.boxed(r), false, "chain_box_unbox_tagged")

print("running chain_overflow_rebox")
r = big * big + 1
test.equal(math.boxed(r), true, "chain_overflow_rebox")

test.done()
