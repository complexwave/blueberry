var h = require("tests/test_helpers.ci")
h()

print("running bitwise tests")

// === Basic bitwise operators ===
print("running bitwise_basic")
test.equal(~0, -1, "bitwise_not_zero")

var a = number("0xFFFFFFFFFFFFFFFF")
// 0xFFFFFFFFFFFFFFFF is not -1 in 128-bit signed
test.equal(a == -1, false, "bitwise_wide_neq_neg1")
test.equal(a & -1, a, "bitwise_and_with_neg1")
test.equal(a & 35, 35, "bitwise_and_35")

a = number("0xF0F0F0F0F0F0F0F0")
test.equal(a | -1, -1, "bitwise_or_neg1")
test.equal(a ^ a, 0, "bitwise_xor_self")
test.equal(a ^ 0, a, "bitwise_xor_zero")
test.equal(a ^ ~a, -1, "bitwise_xor_not_self")
test.equal(a >> 4, number("0x0F0F0F0F0F0F0F0F"), "bitwise_shr_4_eq_not")

a = 0xF0
var b = 0xCC
var c = 0xAA
var d = 0xFD
test.equal(a | b ^ c & d, 0xF4, "bitwise_precedence_1")

a = number("0xF0000000")
b = number("0xCC000000")
c = number("0xAA000000")
d = number("0xFD000000")
test.equal(a | b ^ c & d, number("0xF4000000"), "bitwise_large_precedence")
test.equal(~~a, a, "bitwise_double_not")
test.equal(~a, -1 ^ a, "bitwise_not_eq_xor")
test.equal(-d, ~d + 1, "bitwise_neg_eq_not_plus_1")

a = a << 32
b = b << 32
c = c << 32
d = d << 32
test.equal(a | b ^ c & d, number("0xF4000000") << 32, "bitwise_shift_large")
test.equal(~~a, a, "bitwise_double_not_shifted")
test.equal(~a, -1 ^ a, "bitwise_not_shifted")
test.equal(-d, ~d + 1, "bitwise_neg_shifted")

// === Shift operations ===
print("running bitwise_shifts")
test.equal(-1 >> 1, -1, "shr_neg1_by_1")
test.equal(1 << 31, number("0x80000000"), "shl_1_by_31")
// negative shift amount is UB
test.equal(1 >> 100, 0, "shr_large_shift")
test.equal(1 << 100, number("0x10000000000000000000000000"), "shl_large_shift")

// === Shift with max/min ===
print("running bitwise_extremes")
test.equal(1 >> 0, 1, "shr_by_0")
test.equal(1 << 0, 1, "shl_by_0")


// === Bitwise with different operands ===
print("running bitwise_mixed")
a = 15  // 0xF
b = 3   // 0x3
test.equal(a & b, 3, "and_15_3")
test.equal(a | b, 15, "or_15_3")
test.equal(a ^ b, 12, "xor_15_3")
test.equal(~a, -16, "not_15")

// === Shift precedence ===
print("running bitwise_shift_precedence")
test.equal(1 << 3 | 2, 10, "shl_then_or")
test.equal(1 | 2 << 3, 17, "or_then_shl")

// === Large numbers ===
print("running bitwise_large")
test.equal(0x100 & 0xFF, 0, "and_large_small")
test.equal(0x100 | 0xFF, 0x1FF, "or_large_small")
test.equal(0x1000 ^ 0x0F00, 0x1F00, "xor_large")

// === Edge cases ===
print("running bitwise_edge")
test.equal(0 & 0, 0, "and_0_0")
test.equal(0 | 0, 0, "or_0_0")
test.equal(0 ^ 0, 0, "xor_0_0")
test.equal(~0, -1, "not_0_again")
test.equal(0 << 1, 0, "shl_0")
test.equal(0 >> 1, 0, "shr_0")

// === Right associativity check ===
print("running bitwise_assoc")
test.equal(1 ^ 2 ^ 3, 1 ^ (2 ^ 3), "xor_right_assoc")
test.equal(5 & 3 & 1, (5 & 3) & 1, "and_left_assoc")
test.equal(1 | 2 | 4, (1 | 2) | 4, "or_left_assoc")

// === Mixed with arithmetic ===
print("running bitwise_arithmetic")
test.equal((1 + 1) << 2, 8, "add_then_shl")
test.equal((8 / 2) & 3, 0, "div_then_and")
test.equal(10 % 7 | 1, 3, "mod_then_or")

test.done()
