// Constructs tests ported from Lua 5.5 test suite
// Most control flow is already covered in controlflow/* but this adds
// edge cases, operator precedence, multi-return functions, etc.

var h = require("tests/test_helpers.ci")
h()

// ===== OPERATOR PRECEDENCE TESTS =====
print("running operator_precedence_arithmetic")

var a = 0
a = 2 * 3 * 4
test.equal(a, 24, "multiply_left_associative")

print("running operator_precedence_add")
a = 2 + 3 + 4
test.equal(a, 9, "add_left_associative")

print("running operator_precedence_subtract")
a = 2 - 3 - 4
test.equal(a, -5, "subtract_left_associative")

print("running operator_precedence_unary")
a = -3 - 1 - 5
test.equal(a, -9, "unary_minus_precedence")

a = -2 * 2
test.equal(a, -4, "unary_minus_before_multiply")

a = (-2) * 2
test.equal(a, -4, "unary_minus_parens")

print("running operator_precedence_mixed")
a = 2 * 1 + 3 / 3
test.equal(a, 3, "multiply_before_add")

print("running comparison_results")
a = (1 + 2) != (3 * 1)
test.equal(a, false, "comparison_result_is_bool")

print("running complex_arithmetic_precedence")
a = 3 > (4 * 5 / 2 * 3 / 9 + 4 % 10 / 3)
test.equal(a, false, "complex_arithmetic_precedence")

print("running logical_precedence")
a = !(!true && !null)
test.equal(a, false, "double_negation")

a = true || (false && null)
test.equal(a, true, "or_lower_precedence_than_and")

a = (null && true) || false
test.equal(a, false, "and_higher_precedence_than_or")

// ===== LOGICAL OPERATOR EDGE CASES =====
print("running logical_operator_edge_cases_null")

var x = 0
var y = 0

x = (true || false) && null
test.equal(x, null, "or_then_and_with_null")

print("running logical_or_short_circuit")
x = true || (false && null)
test.equal(x, true, "or_short_circuits_and")

print("running logical_or_returns_truthy")
a = (1 || false) && true
test.equal(a, true, "or_returns_first_truthy")

print("running logical_and_returns_false")
a = (null && true) || false
test.equal(a, false, "and_returns_null")

print("running complex_and_or_chain")
a = 1
var b = 2
x = (a > b) && a || (b == 2)
test.equal(x, true, "complex_and_or_chain")

print("running or_returns_second")
a = 1
b = 2
x = (a > b) && a || b
test.equal(x == 2, true, "or_returns_second_if_first_falsy")

print("running comparison_in_or")
x = (a >= b) || (a == 1)
test.equal(x, true, "comparison_in_or")

print("running comparison_short_circuits2")
x = (a < b) || (a == 1)
test.equal(x, true, "comparison_short_circuits")

print("running and_evaluates_both")
a = 3
b = 4
x = a && (b < 3)
test.equal(x, false, "and_evaluates_both")

// ===== COMPARISON CHAINS =====
print("running comparison_basic")

a = 1
b = 2
var c = 3

x = 1 < 2
test.equal(x, true, "comparison_true")

print("running comparison_false")
x = 2 < 1
test.equal(x, false, "comparison_false")

print("running comparison_equality")
x = 1 == 1
test.equal(x, true, "equality_true")

x = 1 != 2
test.equal(x, true, "inequality_true")

print("running comparison_chained")
x = (2 < 3) && (3 < 4)
test.equal(x, true, "chained_comparisons_both_true")

x = (2 < 3) && (5 < 4)
test.equal(x, false, "chained_comparisons_second_false")

// ===== BITWISE OPERATIONS =====
print("running bitwise_or")

a = 0xF0 | 0xCC
test.equal(a, 0xFC, "bitwise_or")

print("running bitwise_and")
a = 0xFD & 0xAA
test.equal(a, 0xA8, "bitwise_and")

print("running bitwise_or_full")
a = 0xF0 | 0x0F
test.equal(a, 0xFF, "bitwise_or_full")

print("running bitwise_shift")
a = 5 << 1
test.equal(a, 10, "bitwise_left_shift")

a = 5 >> 1
test.equal(a, 2, "bitwise_right_shift")

print("running bitwise_xor")
a = 5 ^ 3
test.equal(a, 6, "bitwise_xor")

print("running bitwise_not")
a = ~5
test.equal(a, -6, "bitwise_not")

// ===== SIMPLE LOOPS =====
print("running silly_loops tests")

var count = 0
while false {
	count = count + 1
}
test.equal(count, 0, "while_false_skips")

count = 0
do {
	count = count + 1
} while false
test.equal(count, 1, "do_while_false_executes_once")

// ===== NESTED SCOPE TESTS =====
print("running nested_scope tests")

x = 10
if true {
	var local_x = 20
	x = local_x
}
test.equal(x, 20, "if_local_variable_scope")

x = 10
if false {
	x = 999
}
test.equal(x, 10, "if_false_preserves_outer")

// ===== MULTI-RETURN FUNCTIONS =====
print("running multi_return_define_f")

fn test_multi_f(i) {
	if type(i) != "int" {
		return i, "jojo"
	}
	if i > 0 {
		return i, self(i - 1)
	}
}

// Test multi-return unpacking in assignment
print("running multi_return_unpacking")
var r1 = null
var r2 = null
r1, r2 = test_multi_f(1)
test.equal(r1, 1, "multi_return_first_value")
test.equal(r2 == null, true, "multi_return_second_null")

print("running multi_return_recursion")
r1, r2 = test_multi_f(3)
test.equal(r1, 3, "multi_return_recursion_first")
test.equal(r2, 2, "multi_return_recursion_second")

// Test multi-return in array initialization
print("running multi_return_in_array")
var tbl = [test_multi_f(3), test_multi_f(5), test_multi_f(10)]
test.equal(tbl[0], 3, "array_from_multireturn_first")
test.equal(tbl[1], 5, "array_from_multireturn_second")
test.equal(tbl[2], 10, "array_from_multireturn_third")

// Test multi-return from string arg
print("running multi_return_string")
r1, r2 = test_multi_f("hello")
test.equal(r1, "hello", "multi_return_string_arg")
test.equal(r2, "jojo", "multi_return_string_second")

// ===== IF/ELSEIF/ELSE CHAINS =====
print("running if_elseif_define_classify")

fn test_classify(i) {
	if i < 10 {
		return "a"
	} else if i < 20 {
		return "b"
	} else if i < 30 {
		return "c"
	}
}

print("running if_elseif_calls")
test.equal(test_classify(3), "a", "if_elseif_returns_a")
test.equal(test_classify(12), "b", "if_elseif_returns_b")
test.equal(test_classify(26), "c", "if_elseif_returns_c")
test.equal(test_classify(100), null, "if_elseif_returns_null")

print("running if_elseif_else_define")
fn test_classify2(i) {
	if i < 10 {
		return "a"
	} else if i < 20 {
		return "b"
	} else if i < 30 {
		return "c"
	} else {
		return "d"
	}
}

print("running if_elseif_else_calls")
test.equal(test_classify2(3), "a", "if_elseif_else_a")
test.equal(test_classify2(12), "b", "if_elseif_else_b")
test.equal(test_classify2(26), "c", "if_elseif_else_c")
test.equal(test_classify2(100), "d", "if_elseif_else_d")

// ===== NESTED LOOPS WITH CONTROL FLOW =====
print("running nested_loops_triangle")

var n = 10  // smaller for faster test
var iter = 3
var t = {}
var nested_result = null
var count = 0

while nested_result == null {
	nested_result = 0
	var i = 1
	while i <= n {
		var j = i
		while j >= 1 {
			nested_result = nested_result + 1
			j = j - 1
		}
		i = i + 1
	}
}

test.equal(nested_result == n * (n + 1) / 2, true, "nested_loops_triangle_count")

// ===== LOOP WITH BREAK/NEXT COMBINATIONS =====
print("running loop_test_define")

fn test_loop_with_break(mode) {
	var x = 1
	var result = 0
	while true {
		if mode == 1 && x > 3 {
			break
		}
		if mode == 2 && x > 5 {
			break
		}
		if x % 2 == 0 {
			x = x + 1
			next
		}
		result = result + x
		x = x + 1
	}
	return result
}

print("running loop_test_call")
var res1 = test_loop_with_break(1)
test.equal(res1 == 4, true, "loop_with_break_odd_sum")

print("running loop_repeat_define")
fn test_loop_repeat() {
	var x = 1
	var result = 0
	do {
		if x % 2 == 1 {
			result = result + x
		}
		x = x + 1
	} while x < 5
	return result
}

print("running loop_repeat_call")
var res2 = test_loop_repeat()
test.equal(res2, 4, "do_while_odd_sum")

// ===== FUNCTION RETURN BEHAVIORS =====
print("running function_multi_return_define")

fn test_multi_return() {
	return 1, 2, 3
}

print("running function_multi_return_unpack")
var m1 = 0
var m2 = 0
var m3 = 0
m1, m2, m3 = test_multi_return()
test.equal(m1, 1, "multi_return_unpack_first")
test.equal(m2, 2, "multi_return_unpack_second")
test.equal(m3, 3, "multi_return_unpack_third")

// Test multi-return in parentheses (only first value)
print("running function_multi_return_parens")
m1, m2 = (test_multi_return())
test.equal(m1, 1, "multi_return_parens_first")

print(m2)
test.equal(m2 == null, true, "multi_return_parens_only_first")

print("running function_early_return_define")
fn test_early_return() {
	if true {
		return 10
	}
	return 20
}

print("running function_early_return_call")
test.equal(test_early_return(), 10, "early_return")

print("running function_return_from_while_define")
fn test_return_from_while() {
	var i = 1
	while i <= 10 {
		if i == 5 {
			return i
		}
		i = i + 1
	}
	return 0
}

print("running function_return_from_while_call")
test.equal(test_return_from_while(), 5, "return_from_while")

print("running function_return_from_if_define")
fn test_return_from_if() {
	var x = 5
	if x > 3 {
		return x * 2
	} else {
		return x
	}
}

print("running function_return_from_if_call")
test.equal(test_return_from_if(), 10, "return_from_if_true")

