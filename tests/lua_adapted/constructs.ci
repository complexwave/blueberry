test.equal(result, 2, "or_then_and")

// ===== NULL COALESCING BEHAVIOR =====
print("running null_coalesce_left_null")

result = null ?? 5
test.equal(result, 5, "null_coalesce_left_null")

print("running null_coalesce_left_zero")
result = 0 ?? 5
test.equal(result, 0, "null_coalesce_left_zero")

print("running null_coalesce_left_truthy")
result = 1 ?? 5
test.equal(result, 1, "null_coalesce_left_truthy")

// ===== TRUTHINESS EDGE CASES =====
print("running truthiness_empty_string")

// Empty string is truthy
var passed_empty_string = false
if "" {
	passed_empty_string = true
}
test.equal(passed_empty_string, true, "empty_string_truthy")

// Empty array is truthy
print("running truthiness_empty_array")
var passed_empty_array = false
if [] {
	passed_empty_array = true
}
test.equal(passed_empty_array, true, "empty_array_truthy")

// Empty map is truthy
print("running truthiness_empty_map")
var passed_empty_map = false
if {} {
	passed_empty_map = true
}
test.equal(passed_empty_map, true, "empty_map_truthy")

// Zero is falsy
print("running truthiness_zero_falsy")
count = 0
if 0 {
	count = 1
}
test.equal(count, 0, "zero_falsy")

// null is falsy
print("running truthiness_null_falsy")
count = 0
if null {
	count = 1
}
test.equal(count, 0, "null_falsy")

// false is falsy
print("running truthiness_false_falsy")
count = 0
if false {
	count = 1
}
test.equal(count, 0, "false_falsy")

// ===== RETURN IN DIFFERENT CONTEXTS =====
print("running return_in_do_while_define")

fn test_return_in_do_while() {
	var i = 0
	do {
		i = i + 1
		if i == 3 {
			return i
		}
	} while i < 10
	return 0
}

print("running return_in_do_while_call")
test.equal(test_return_in_do_while(), 3, "return_in_do_while")

print("running return_in_nested_if_define")
fn test_return_in_nested_if() {
	var x = 5
	if x > 0 {
		if x < 10 {
			return x
		}
		return 0
	}
	return -1
}

print("running return_in_nested_if_call")
test.equal(test_return_in_nested_if(), 5, "return_in_nested_if")

