test.equal(result, 5, "zero_or_value")

print("running mixed_operators_zero_and")
result = 0 && 5
test.equal(result, 0, "zero_and_value")

print("running mixed_operators_zero_and2")
result = 5 && 0
test.equal(result, 5, "zero_and_value2")

