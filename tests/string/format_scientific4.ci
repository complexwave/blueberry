// String tests: %g number(), width/padding, mixed e+g, inf/nan
var h = require("tests/test_helpers.ci")
h()

// === %g with number() ===
print("running fmt_g_num_1_5e10")
var s = string.format("%g", number("1.5e10"))
test.equal(s.eq("1.5e10"), true, "fmt_g_num_1_5e10")

print("running fmt_g_num_1_5e_10")
s = string.format("%g", number("1.5e-10"))
test.equal(s.eq("1.5e-10"), true, "fmt_g_num_1_5e_10")

print("running fmt_g_num_1e100")
s = string.format("%g", number("1e100"))
test.equal(s.eq("1e100"), true, "fmt_g_num_1e100")

print("running fmt_g_num_9_99e5")
s = string.format("%g", number("9.99e5"))
test.equal(s.eq("999000"), true, "fmt_g_num_9_99e5")

print("running fmt_g_num_6_022e23")
s = string.format("%g", number("6.022e23"))
test.equal(s.eq("6.022e23"), true, "fmt_g_num_6_022e23")

print("running fmt_g_num_neg_6_022e23")
s = string.format("%g", number("-6.022e23"))
test.equal(s.eq("-6.022e23"), true, "fmt_g_num_neg_6_022e23")

print("running fmt_g_num_1e0")
s = string.format("%g", number("1e0"))
test.equal(s.eq("1"), true, "fmt_g_num_1e0")

print("running fmt_g_num_1e1")
s = string.format("%g", number("1e1"))
test.equal(s.eq("10"), true, "fmt_g_num_1e1")

print("running fmt_g_num_5e2")
s = string.format("%g", number("5e2"))
test.equal(s.eq("500"), true, "fmt_g_num_5e2")

print("running fmt_g_1_0")
s = string.format("%g", 1.0)
test.equal(s.eq("1"), true, "fmt_g_1_0")

// === %g with width/padding ===
print("running fmt_g_width_right")
s = string.format("[%20g]", 3.14)
test.equal(s.eq("[                3.14]"), true, "fmt_g_width_right")

print("running fmt_g_width_left")
s = string.format("[%-20g]", 3.14)
test.equal(s.eq("[3.14                ]"), true, "fmt_g_width_left")

print("running fmt_g_width_zeropad")
s = string.format("[%020g]", 3.14)
test.equal(s.eq("[00000000000000003.14]"), true, "fmt_g_width_zeropad")

print("running fmt_g_width_int")
s = string.format("[%20g]", 42)
test.equal(s.eq("[                  42]"), true, "fmt_g_width_int")

print("running fmt_g_width_int_left")
s = string.format("[%-20g]", 42)
test.equal(s.eq("[42                  ]"), true, "fmt_g_width_int_left")

// === mixed %e and %g ===
print("running fmt_eg_mixed_pi")
s = string.format("e=%e g=%g", 3.14, 3.14)
test.equal(s.eq("e=3.14 g=3.14"), true, "fmt_eg_mixed_pi")

print("running fmt_eg_mixed_small")
s = string.format("e=%e g=%g", 0.001, 0.001)
test.equal(s.eq("e=1e-3 g=0.001"), true, "fmt_eg_mixed_small")

print("running fmt_eg_mixed_int")
s = string.format("e=%e g=%g", 100, 100)
test.equal(s.eq("e=100 g=100"), true, "fmt_eg_mixed_int")

// === inf / nan / -inf ===
print("running fmt_e_inf")
s = string.format("%e", float("inf"))
test.equal(s.eq("inf"), true, "fmt_e_inf")

print("running fmt_e_neg_inf")
s = string.format("%e", float("-inf"))
test.equal(s.eq("-inf"), true, "fmt_e_neg_inf")

print("running fmt_e_nan")
s = string.format("%e", float("nan"))
test.equal(s.eq("nan"), true, "fmt_e_nan")

print("running fmt_g_inf")
s = string.format("%g", float("inf"))
test.equal(s.eq("inf"), true, "fmt_g_inf")

print("running fmt_g_neg_inf")
s = string.format("%g", float("-inf"))
test.equal(s.eq("-inf"), true, "fmt_g_neg_inf")

print("running fmt_g_nan")
s = string.format("%g", float("nan"))
test.equal(s.eq("nan"), true, "fmt_g_nan")

test.done()
