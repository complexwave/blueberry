// String tests: extensive slice (copy) coverage
var h = require("tests/test_helpers.ci")
h()

var s = "abcdefghij"
var r = null

// === slice copies are independent ===
print("running slice_independent")
r = s.slice(0, 5)
r.append("X")
test.equal(r.eq("abcdeX"), 1, "slice_independent")
test.equal(s.eq("abcdefghij"), 1, "slice_independent")

// === slice entire string ===
print("running slice_full")
r = s.slice(0)
test.equal(r.eq("abcdefghij"), 1, "slice_full")
r = s.slice(0, 10)
test.equal(r.eq("abcdefghij"), 1, "slice_full")

// === single char slices ===
print("running slice_each_char")
r = s.slice(0, 1)
test.equal(r.eq("a"), 1, "slice_each_char")
r = s.slice(9, 10)
test.equal(r.eq("j"), 1, "slice_each_char")
r = s.slice(4, 5)
test.equal(r.eq("e"), 1, "slice_each_char")

// === negative combos ===
print("running slice_neg_both")
r = s.slice(-5, -2)
test.equal(r.eq("fgh"), 1, "slice_neg_both")

print("running slice_neg_start_pos_end")
r = s.slice(-3, 10)
test.equal(r.eq("hij"), 1, "slice_neg_start_pos_end")

print("running slice_pos_start_neg_end")
r = s.slice(2, -2)
test.equal(r.eq("cdefgh"), 1, "slice_pos_start_neg_end")

// === clamp extremes ===
print("running slice_clamp_neg_start")
r = s.slice(-100, 3)
test.equal(r.eq("abc"), 1, "slice_clamp_neg_start")

print("running slice_clamp_big_end")
r = s.slice(7, 9999)
test.equal(r.eq("hij"), 1, "slice_clamp_big_end")

print("running slice_clamp_both")
r = s.slice(-999, 999)
test.equal(r.eq("abcdefghij"), 1, "slice_clamp_both")

// === empty results ===
print("running slice_empty_same")
r = s.slice(3, 3)
test.equal(r.len(), 0, "slice_empty_same")

print("running slice_empty_reversed")
r = s.slice(7, 2)
test.equal(r.len(), 0, "slice_empty_reversed")

print("running slice_empty_neg_reversed")
r = s.slice(-1, -5)
test.equal(r.len(), 0, "slice_empty_neg_reversed")

// === empty source ===
print("running slice_empty_source")
r = "".slice(0)
test.equal(r.len(), 0, "slice_empty_source")
r = "".slice(0, 0)
test.equal(r.len(), 0, "slice_empty_source")

// === slice of a slice ===
print("running slice_of_slice")
r = s.slice(2, 8)
r = r.slice(1, 4)
test.equal(r.eq("def"), 1, "slice_of_slice")

// === slice is writable copy ===
print("running slice_writable")
r = s.slice(0, 3)
test.equal(r.is_readonly(), false, "slice_writable")
test.equal(r.is_slice(), false, "slice_writable")

test.done()
