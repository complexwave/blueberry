
// OOB read returns null
var a = []
var x = a[5]
print(x)          // null

// OOB write auto-extends
a[3] = 99
print(a.len())    // 4
print(a[0])       // null
print(a[1])       // null
print(a[2])       // null
print(a[3])       // 99

// extend further
a[5] = 42
print(a.len())    // 6
print(a[4])       // null
print(a[5])       // 42
