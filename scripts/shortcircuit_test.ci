// Test short-circuit && and || operators
// Key: short-circuit means RHS is NOT evaluated if LHS determines result

var pass = 0;
var total = 0;

// Test 1: && with false LHS (RHS should NOT be evaluated)
var test1_rhs_called = 0;
total++;
var result1 = (0 && (test1_rhs_called = 1));
if (result1 == 0 && test1_rhs_called == 0) {
	print("test1_and_short_false: pass");
	pass++;
} else {
	print("test1_and_short_false: fail");
}

// Test 2: && with true LHS (RHS should be evaluated)
var test2_rhs_called = 0;
total++;
var result2 = (1 && (test2_rhs_called = 1));
if (result2 != 0 && test2_rhs_called == 1) {
	print("test2_and_eval_rhs: pass");
	pass++;
} else {
	print("test2_and_eval_rhs: fail");
}

// Test 3: && with true && true
total++;
var result3 = (5 > 2 && 10 > 3);
if (result3 != 0) {
	print("test3_and_both_true: pass");
	pass++;
} else {
	print("test3_and_both_true: fail");
}

// Test 4: && with true && false
total++;
var result4 = (5 > 2 && 10 < 3);
if (result4 == 0) {
	print("test4_and_true_false: pass");
	pass++;
} else {
	print("test4_and_true_false: fail");
}

// Test 5: || with true LHS (RHS should NOT be evaluated)
var test5_rhs_called = 0;
total++;
var result5 = (1 || (test5_rhs_called = 1));
if (result5 != 0 && test5_rhs_called == 0) {
	print("test5_or_short_true: pass");
	pass++;
} else {
	print("test5_or_short_true: fail");
}

// Test 6: || with false LHS (RHS should be evaluated)
var test6_rhs_called = 0;
total++;
var result6 = (0 || (test6_rhs_called = 1));
if (result6 != 0 && test6_rhs_called == 1) {
	print("test6_or_eval_rhs: pass");
	pass++;
} else {
	print("test6_or_eval_rhs: fail");
}

// Test 7: || with false || false
total++;
var result7 = (0 || 0);
if (result7 == 0) {
	print("test7_or_both_false: pass");
	pass++;
} else {
	print("test7_or_both_false: fail");
}

// Test 8: || with false || true
total++;
var result8 = (0 || 1);
if (result8 != 0) {
	print("test8_or_false_true: pass");
	pass++;
} else {
	print("test8_or_false_true: fail");
}

// Test 9: Chained && (should short-circuit at first false)
var test9_count = 0;
total++;
var result9 = (0 && (test9_count = 1) && (test9_count = 2));
if (result9 == 0 && test9_count == 0) {
	print("test9_chained_and_short: pass");
	pass++;
} else {
	print("test9_chained_and_short: fail");
}

// Test 10: Chained || (should short-circuit at first true)
var test10_count = 0;
total++;
var result10 = (1 || (test10_count = 1) || (test10_count = 2));
if (result10 != 0 && test10_count == 0) {
	print("test10_chained_or_short: pass");
	pass++;
} else {
	print("test10_chained_or_short: fail");
}

// Test 11: && in if condition
var test11_val = 0;
total++;
if (1 && 1) {
	test11_val = 99;
}
if (test11_val == 99) {
	print("test11_and_in_if: pass");
	pass++;
} else {
	print("test11_and_in_if: fail");
}

// Test 12: || in if condition
var test12_val = 0;
total++;
if (0 || 1) {
	test12_val = 88;
}
if (test12_val == 88) {
	print("test12_or_in_if: pass");
	pass++;
} else {
	print("test12_or_in_if: fail");
}

print("---");
print(pass);
print(total);
