print(string.format("%:r:s", "red"))
print(string.format("%:g:s", "green"))
print(string.format("%:b:s", "blue"))
print(string.format("%:y:s", "yellow"))
print(string.format("%:c:s", "cyan"))
print(string.format("%:m:s", "magenta"))
print(string.format("%:w:s", "white"))
print(string.format("%:bold:s", "bold"))
print(string.format("%:dim:s", "dim"))
print(string.format("%:italic:s", "italic"))
print(string.format("%:ul:s", "underline"))
print(string.format("%[R,bold: bright red bold ]"))
print(string.format("%[y,ul: yellow underline ]"))
