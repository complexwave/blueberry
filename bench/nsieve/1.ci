// nsieve benchmark

fn nsieve(m) {
    var flags = []
    flags.resize(m)
    var i = 2
    while i < m {
        flags[i] = 1
        i = i + 1
    }
    var count = 0
    i = 2
    while i < m {
        if flags[i] {
            count = count + 1
            var j = i + i
            while j < m {
                flags[j] = 0
                j = j + i
            }
        }
        i = i + 1
    }
    print("Primes up to", m, count)
}

var N = str2int(argv[0])
var i = 0
while i < 3 {
    nsieve(10000 * (1 << (N - i)))
    i = i + 1
}
