// map/prototype chain access benchmark
// heavy on nested field lookups via proto.set, light on function calls


var N = 10000000


var leaf = {}
leaf.p = 100
leaf.q = 200
leaf.r = 300

var sum = 0
var i = 0
while i < N {
    // prototype chain lookups (inherited fields)
    //sum = sum + leaf.x
    //sum = sum + leaf.y
    //sum = sum + leaf.z
    //sum = sum + leaf.a
   // sum = sum + leaf.b
   // sum = sum + leaf.c
    
    
    // own fields
    sum = sum + leaf.p
    sum = sum + leaf.q
    sum = sum + leaf.r

	sum = sum + leaf.p
    sum = sum + leaf.q
    sum = sum + leaf.r
    
	sum = sum + leaf.p
    sum = sum + leaf.q
    sum = sum + leaf.r
    
	sum = sum + leaf.p
    sum = sum + leaf.q
    sum = sum + leaf.r
    i = i + 1
}

