// spectral-norm benchmark

fn A(i, j) {
    var ij = i + j - 1
    return 1.0 / (ij * (ij - 1) * 0.5 + i)
}

fn Av(x, y, N) {
    var i = 1
    while i <= N {
        var a = 0.0
        var j = 1
        while j <= N {
            a = a + x[j] * A(i, j)
            j = j + 1
        }
        y[i] = a
        i = i + 1
    }
}

fn Atv(x, y, N) {
    var i = 1
    while i <= N {
        var a = 0.0
        var j = 1
        while j <= N {
            a = a + x[j] * A(j, i)
            j = j + 1
        }
        y[i] = a
        i = i + 1
    }
}

fn AtAv(x, y, t, N) {
    Av(x, t, N)
    Atv(t, y, N)
}

var N = str2int(argv[0])
var u = []
var v = []
var t = []
u.resize(N + 1)
v.resize(N + 1)
t.resize(N + 1)

var i = 1
while i <= N {
    u[i] = 1.0
    i = i + 1
}

i = 0
while i < 10 {
    AtAv(u, v, t, N)
    AtAv(v, u, t, N)
    i = i + 1
}

var vBv = 0.0
var vv = 0.0
i = 1
while i <= N {
    var ui = u[i]
    var vi = v[i]
    vBv = vBv + ui * vi
    vv = vv + vi * vi
    i = i + 1
}
print(math.sqrt(vBv / vv))
